{
    "collectionName": "components_sections_heroes",
    "info": {
        "displayName": "Hero"
    },
    "options": {},
    "attributes": {
        "content": {
            "type": "component",
            "component": "shared.title-subtitle-description",
            "repeatable": false,
            "required": false
        },
        "tagline": {
            "type": "string"
        },
        "id_anchor": {
            "type": "string"
        },
        "background": {
            "type": "component",
            "component": "media.background-media",
            "repeatable": false,
            "required": false
        },
        "cta_mode": {
            "type": "enumeration",
            "enum": [
                "simple",
                "existing"
            ],
            "default": "simple",
            "required": false
        },
        "cta": {
            "type": "component",
            "component": "buttons.cta",
            "repeatable": false,
            "required": false,
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "cta_mode"
                        },
                        "simple"
                    ]
                }
            }
        },
        "selected_cta": {
            "type": "component",
            "component": "buttons.selected-cta",
            "repeatable": false,
            "required": false,
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "cta_mode"
                        },
                        "existing"
                    ]
                }
            }
        }
    },
    "config": {}
}
