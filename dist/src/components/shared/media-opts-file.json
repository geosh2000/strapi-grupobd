{
    "collectionName": "components_shared_media_opts_files",
    "info": {
        "displayName": "media opts file",
        "icon": "file"
    },
    "options": {},
    "attributes": {
        "source": {
            "type": "enumeration",
            "enum": [
                "local",
                "url"
            ],
            "default": "local",
            "required": true
        },
        "local_media": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "files"
            ],
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "source"
                        },
                        "local"
                    ]
                }
            }
        },
        "media_url": {
            "type": "text",
            "required": false,
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "source"
                        },
                        "url"
                    ]
                }
            }
        }
    },
    "config": {}
}
