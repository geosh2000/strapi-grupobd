{
    "collectionName": "components_shared_icon_images",
    "info": {
        "displayName": "icon_image"
    },
    "options": {},
    "attributes": {
        "type": {
            "type": "enumeration",
            "enum": [
                "icon",
                "image"
            ]
        },
        "icon": {
            "type": "customField",
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "type"
                        },
                        "icon"
                    ]
                }
            },
            "customField": "plugin::strapi-plugin-iconhub.iconhub",
            "options": {
                "storeIconData": true,
                "storeIconName": true
            }
        },
        "image": {
            "type": "media",
            "conditions": {
                "visible": {
                    "==": [
                        {
                            "var": "type"
                        },
                        "image"
                    ]
                }
            },
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        }
    },
    "config": {}
}
