{
    "kind": "collectionType",
    "collectionName": "headers",
    "info": {
        "singularName": "header",
        "pluralName": "headers",
        "displayName": "header"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "site": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::site.site",
            "inversedBy": "header"
        },
        "name": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "slug": {
            "type": "customField",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "customField": "plugin::auto-locales-slug.auto-locales-slug",
            "required": true,
            "options": {
                "pattern": "name"
            }
        },
        "logo": {
            "type": "media",
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            },
            "multiple": false,
            "allowedTypes": [
                "images"
            ]
        },
        "links": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::link.link"
        }
    }
}
