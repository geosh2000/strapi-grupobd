{
  "collectionName": "components_shared_social_medias",
  "info": {
    "displayName": "socialMedia",
    "icon": "user"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "in_section": {
      "type": "boolean"
    },
    "section": {
      "type": "string"
    },
    "sort": {
      "type": "integer"
    },
    "icon_type": {
      "type": "enumeration",
      "enum": [
        "image",
        "svg"
      ]
    },
    "icon": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "icon_type"
            },
            "image"
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "svg": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "icon_type"
            },
            "svg"
          ]
        }
      },
      "customField": "plugin::strapi-plugin-iconhub.iconhub",
      "options": {
        "storeIconData": true,
        "storeIconName": true
      }
    },
    "altText": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "class": {
      "type": "text"
    },
    "css": {
      "type": "customField",
      "customField": "plugin::strapi-code-editor-custom-field.code-editor-text",
      "options": {
        "language": "css"
      }
    },
    "type": {
      "type": "string",
      "default": "socialMedia"
    }
  },
  "config": {}
}
