{
  "collectionName": "components_shared_title_subtitle_descriptions",
  "info": {
    "displayName": "title_subtitle_description"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "richtext"
    },
    "description": {
      "type": "richtext"
    },
    "cta_mode": {
      "type": "enumeration",
      "enum": [
        "simple",
        "existing"
      ],
      "default": "simple",
      "required": false
    },
    "cta": {
      "type": "component",
      "component": "buttons.cta",
      "repeatable": true,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "cta_mode"
            },
            "simple"
          ]
        }
      }
    },
    "selected_cta": {
      "type": "component",
      "component": "buttons.selected-cta",
      "repeatable": true,
      "required": false,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "cta_mode"
            },
            "existing"
          ]
        }
      }
    },
    "footer": {
      "type": "richtext"
    }
  },
  "config": {}
}
