{
  "collectionName": "components_shared_single_cards",
  "info": {
    "displayName": "single_card"
  },
  "options": {},
  "attributes": {
    "content": {
      "type": "component",
      "component": "shared.title-subtitle-description",
      "repeatable": true
    },
    "order": {
      "type": "integer",
      "min": 0
    },
    "has_media": {
      "type": "boolean",
      "default": false
    },
    "media_type": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "has_media"
            },
            true
          ]
        }
      },
      "enum": [
        "icon",
        "image",
        "video",
        "carousel"
      ]
    },
    "card_icon": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "media_type"
            },
            "icon"
          ]
        }
      },
      "customField": "plugin::strapi-plugin-iconhub.iconhub",
      "options": {
        "storeIconData": true,
        "storeIconName": true
      }
    },
    "card_image": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "media_type"
            },
            "image"
          ]
        }
      },
      "component": "shared.media-opts-image",
      "repeatable": false,
      "required": false
    },
    "card_video": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "media_type"
            },
            "video"
          ]
        }
      },
      "component": "shared.media-opts-video",
      "repeatable": false,
      "required": false
    },
    "card_carousel": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "media_type"
            },
            "carousel"
          ]
        }
      },
      "component": "shared.media-opts-carousel",
      "repeatable": false,
      "required": false
    },
    "has_cta": {
      "type": "boolean",
      "default": false
    },
    "cta_mode": {
      "type": "enumeration",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "has_cta"
            },
            true
          ]
        }
      },
      "required": false,
      "default": "simple",
      "enum": [
        "simple",
        "existing"
      ]
    },
    "cta": {
      "type": "component",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "has_cta"
                },
                true
              ]
            },
            {
              "==": [
                {
                  "var": "cta_mode"
                },
                "simple"
              ]
            }
          ]
        }
      },
      "component": "buttons.cta",
      "repeatable": false
    },
    "selected_cta": {
      "type": "component",
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "has_cta"
                },
                true
              ]
            },
            {
              "==": [
                {
                  "var": "cta_mode"
                },
                "existing"
              ]
            }
          ]
        }
      },
      "component": "buttons.selected-cta",
      "repeatable": false,
      "required": false
    },
    "background_color": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    }
  },
  "config": {}
}
