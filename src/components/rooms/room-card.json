      "target": "api::room-amenity.room-amenity"
    },
    "main_picture": {
      "type": "component",
      "component": "shared.media-opts-image",
      "repeatable": false
    },
    "carousel": {
      "type": "component",
      "component": "shared.media-opts-carousel",
      "repeatable": false
    }
  },
  "config": {}
}
