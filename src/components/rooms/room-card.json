{
  "collectionName": "components_rooms_room_cards",
  "info": {
    "displayName": "room-card",
    "icon": "stack"
  },
  "options": {},
  "attributes": {
    "description": {
      "type": "blocks"
    },
    "short_description": {
      "type": "blocks"
    },
    "view_360": {
      "type": "boolean"
    },
    "view_360_url": {
      "type": "string",
      "conditions": {
