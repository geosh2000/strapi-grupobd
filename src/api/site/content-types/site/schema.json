{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "domain_us": {
      "type": "string",
      "required": true
    },
    "domain_mx": {
      "type": "string",
      "required": false
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "site"
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq",
      "mappedBy": "site"
    },
    "global_css": {
      "type": "customField",
      "customField": "plugin::strapi-code-editor-custom-field.code-editor-text",
      "options": {
        "language": "css"
      }
    },
    "contact_fields": {
      "type": "component",
      "component": "shared.contact",
      "repeatable": false
    },
    "mail": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::mail.mail",
      "mappedBy": "site"
    }
  }
}
