{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "domain_us": {
      "type": "string",
      "required": true
    },
    "privacy_policy_en": {
      "type": "string"
    },
    "domain_mx": {
      "type": "string",
      "required": false
    },
    "privacy_policy_es": {
      "type": "string"
    },
    "contact_fields": {
      "type": "component",
      "component": "shared.contact",
      "repeatable": false
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "site"
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq",
      "mappedBy": "site"
    },
    "mail": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::mail.mail",
      "mappedBy": "site"
    },
    "features": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::feature.feature",
      "mappedBy": "site"
    },
    "plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::plan.plan",
      "mappedBy": "site"
    },
    "plan_pivot": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::plan-pivot.plan-pivot",
      "mappedBy": "site"
    },
    "global_css": {
      "type": "customField",
      "customField": "plugin::strapi-code-editor-custom-field.code-editor-text",
      "options": {
        "language": "css"
      }
    },
    "navbar": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::navbar.navbar",
      "mappedBy": "site"
    },
    "footer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::footer.footer",
      "mappedBy": "site"
    },
    "header": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::header.header",
      "mappedBy": "site"
    },
    "page_news": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page-new.page-new",
      "mappedBy": "site"
    },
    "links": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::link.link",
      "mappedBy": "site"
    }
  }
}
