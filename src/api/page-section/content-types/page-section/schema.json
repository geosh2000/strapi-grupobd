{
  "kind": "collectionType",
  "collectionName": "page_sections",
  "info": {
    "singularName": "page-section",
    "pluralName": "page-sections",
    "displayName": "page_section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "private": true,
      "inversedBy": "page_sections"
    },
    "page_new": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page-new.page-new",
      "inversedBy": "page_sections"
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "slug": {
      "type": "customField",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "customField": "plugin::auto-locales-slug.auto-locales-slug",
      "required": true,
      "options": {
        "pattern": "name"
      }
    },
    "active": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": true
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "min": 0
    },
    "content": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "rooms.room-card",
        "sections.hero",
        "sections.cards",
        "sections.thankyou",
        "sections.contact",
        "shared.title-subtitle-description"
      ]
    },
    "visual_setup": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "design.visual-setup",
      "repeatable": false
    }
  }
}
